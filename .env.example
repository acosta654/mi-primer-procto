# Copia este archivo como .env y rellena los valores reales.

# API key de Resend: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Buzón que recibirá las consultas del formulario.
CONTACT_FORM_TO=hola@tramastudio.com

# Remitente verificado en Resend. Para pruebas puedes usar:
# CONTACT_FORM_FROM=Trama Studio <onboarding@resend.dev>
CONTACT_FORM_FROM=Trama Studio <no-reply@tramastudio.com>
